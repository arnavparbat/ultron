# ULTRON AI Brain Configuration
# Supported Providers: groq, gemini, openai, ollama, openrouter, hybrid

# Recommended (Blazing fast & 100% Free Tier): Groq (console.groq.com)
GROQ_API_KEY=

# Google Gemini (aistudio.google.com - Free Tier):
GEMINI_API_KEY=

# OpenAI (platform.openai.com):
OPENAI_API_KEY=

# OpenRouter (openrouter.ai):
OPENROUTER_API_KEY=

# Ollama Host (If using local offline LLM):
OLLAMA_HOST=http://localhost:11434

# Talkative Mode: true for detailed conversational explanations, false for concise answers
ULTRON_TALKATIVE_MODE=true

# Persona Tone: ultron, jarvis, cyber
ULTRON_PERSONA=ultron
